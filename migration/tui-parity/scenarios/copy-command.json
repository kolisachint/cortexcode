{
  "description": "/copy: with nothing to copy it errors; after a reply it copies the last agent message and names the flavour (markdown: no display in the harness, so OSC 52 carries it); '/copy 2' copies turns; '/copy sideways' shows the usage warning on the band. --no-session keeps the footer fixed.",
  "phase": "11.4d1",
  "terminal": {"cols": 100, "rows": 30},
  "settings": {"enableSemanticIndex": false},
  "args": ["--offline", "--light", "--provider", "mock", "--model", "mock-model", "--no-session"],
  "llm": [{"text": "## Findings\n\n| a | b |\n| - | - |\n| 1 | 2 |"}],
  "steps": [
    {"wait_for": "❯", "timeout": 30},
    {"wait_stable": 1.0, "timeout": 20},
    {"type": "/copy"},
    {"keys": ["Enter"]},
    {"wait_for": "No agent messages", "timeout": 20},
    {"wait_stable": 1.0, "timeout": 20},
    {"snapshot": "nothing", "contains": ["No agent messages to copy yet."]},
    {"type": "hi"},
    {"keys": ["Enter"]},
    {"wait_for": "Findings", "timeout": 20},
    {"wait_stable": 1.0, "timeout": 20},
    {"type": "/copy"},
    {"keys": ["Enter"]},
    {"wait_for": "Copied last agent message", "timeout": 20},
    {"wait_stable": 1.0, "timeout": 20},
    {"snapshot": "copied", "contains": ["Copied last agent message as markdown"]},
    {"type": "/copy 2"},
    {"keys": ["Enter"]},
    {"wait_for": "Copied last 2 turns", "timeout": 20},
    {"wait_stable": 1.0, "timeout": 20},
    {"snapshot": "turns", "contains": ["Copied last 2 turns as markdown"]},
    {"type": "/copy sideways"},
    {"keys": ["Enter"]},
    {"wait_for": "Usage: /copy", "timeout": 20},
    {"wait_stable": 1.0, "timeout": 20},
    {"snapshot": "usage", "contains": ["Usage: /copy [all|<number of turns>]"]}
  ]
}
