{
  "description": "Model selection: /model opens the picker (current model first and ticked, the rest by provider), typing narrows it, Enter switches and notifies; alt+m steps to the next model; /scoped-models opens the enable-set picker and Enter toggles a model out of the all-enabled set.",
  "phase": "11.3b",
  "terminal": {
    "cols": 100,
    "rows": 40
  },
  "settings": {
    "enableSemanticIndex": false
  },
  "models": [
    {"id": "mock-model", "name": "Mock Model", "contextWindow": 128000, "maxTokens": 4096},
    {"id": "mock-fast", "name": "Mock Fast", "contextWindow": 64000, "maxTokens": 4096},
    {"id": "mock-large", "name": "Mock Large", "contextWindow": 200000, "maxTokens": 8192}
  ],
  "args": [
    "--offline",
    "--light",
    "--provider",
    "mock",
    "--model",
    "mock-model",
    "--no-session"
  ],
  "llm": [],
  "steps": [
    {"wait_for": "❯", "timeout": 30},
    {"wait_stable": 1.0, "timeout": 20},
    {"type": "/model"},
    {"wait_stable": 1.0, "timeout": 20},
    {"keys": ["Enter"]},
    {"wait_for": "Model Name", "timeout": 20},
    {"wait_stable": 1.0, "timeout": 20},
    {"snapshot": "picker", "contains": ["mock-model", "mock-fast", "mock-large", "Model Name: Mock Model"]},
    {"type": "fast"},
    {"wait_stable": 1.0, "timeout": 20},
    {"snapshot": "filtered", "contains": ["mock-fast", "Model Name: Mock Fast"]},
    {"keys": ["Enter"]},
    {"wait_for": "Model: mock-fast", "timeout": 20},
    {"wait_stable": 1.0, "timeout": 20},
    {"snapshot": "selected", "contains": ["Model: mock-fast"]},
    {"keys": ["M-m"]},
    {"wait_for": "Switched to", "timeout": 20},
    {"wait_stable": 1.0, "timeout": 20},
    {"snapshot": "cycled", "contains": ["Switched to"]},
    {"type": "/scoped-models"},
    {"wait_stable": 1.0, "timeout": 20},
    {"keys": ["Enter"]},
    {"wait_for": "Session-only", "timeout": 20},
    {"wait_stable": 1.0, "timeout": 20},
    {"snapshot": "scoped", "contains": ["Session-only", "all enabled"]},
    {"keys": ["Enter"]},
    {"wait_stable": 1.0, "timeout": 20},
    {"snapshot": "toggled", "contains": ["1/3 enabled", "(unsaved)"]},
    {"keys": ["Escape"]},
    {"wait_gone": "Session-only", "timeout": 20},
    {"wait_stable": 1.0, "timeout": 20},
    {"snapshot": "closed"}
  ]
}
